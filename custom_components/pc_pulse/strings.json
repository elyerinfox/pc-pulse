{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Connect to a computer",
        "description": "Run `pc-pulse info` on the computer to see its host, port and token.",
        "data": {
          "host": "Host",
          "port": "Port",
          "token": "Token"
        },
        "data_description": {
          "host": "IP address or hostname of the computer running the agent.",
          "token": "Access token from the agent's config file."
        }
      },
      "zeroconf_confirm": {
        "title": "Discovered {name}",
        "description": "Found the agent on {name} ({host}). Enter its token to finish setup. Run `pc-pulse info` on that computer to see it.",
        "data": {
          "token": "Token"
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate {name}",
        "description": "The agent rejected the token. Enter the current token from `pc-pulse info`.",
        "data": {
          "token": "Token"
        }
      },
      "reconfigure": {
        "title": "Reconfigure computer",
        "data": {
          "host": "Host",
          "port": "Port",
          "token": "Token"
        }
      }
    },
    "error": {
      "cannot_connect": "Could not connect to the agent. Check the host, port and firewall.",
      "invalid_auth": "The token was rejected.",
      "unknown": "Unexpected error from the agent."
    },
    "abort": {
      "already_configured": "This computer is already configured.",
      "not_supported": "This device is not a supported agent.",
      "reauth_successful": "Re-authentication was successful.",
      "reconfigure_successful": "Reconfiguration was successful.",
      "wrong_computer": "That address belongs to a different computer."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Computer options",
        "data": {
          "scan_interval": "Polling interval (seconds)",
          "mac": "MAC address for Wake-on-LAN",
          "broadcast_address": "Wake-on-LAN broadcast address"
        },
        "data_description": {
          "mac": "Leave empty to use the MAC address reported by the agent.",
          "broadcast_address": "Use the subnet broadcast (e.g. 192.168.1.255) if the default does not work."
        }
      }
    },
    "error": {
      "invalid_mac": "Invalid MAC address."
    }
  },
