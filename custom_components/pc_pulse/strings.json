  "services": {
    "power": {
      "name": "Power action",
      "description": "Shut down, restart, sleep, hibernate, lock or log off a computer.",
      "fields": {
        "device_id": { "name": "Computer", "description": "The computer(s) to act on." },
        "action": { "name": "Action", "description": "What to do." },
        "delay": { "name": "Delay", "description": "Seconds to wait before doing it." }
      }
    },
    "wake": {
      "name": "Wake",
      "description": "Send a Wake-on-LAN packet to a computer.",
      "fields": {
        "device_id": { "name": "Computer", "description": "The computer(s) to wake." }
      }
    },
    "kill_process": {
      "name": "Kill process",
      "description": "Terminate processes on a computer by PID or name.",
      "fields": {
        "device_id": { "name": "Computer", "description": "The computer(s) to act on." },
        "pid": { "name": "PID", "description": "Process ID to kill." },
        "name": { "name": "Name", "description": "Kill every process with this name (e.g. notepad or notepad.exe)." }
      }
    },
    "run_command": {
      "name": "Run command",
      "description": "Run a command defined in the agent's config file.",
      "fields": {
        "device_id": { "name": "Computer", "description": "The computer(s) to act on." },
        "command": { "name": "Command", "description": "Name of the command in the agent's [commands] table." }
      }
    },
    "get_processes": {
      "name": "Get processes",
      "description": "Return the running processes of a computer.",
      "fields": {
        "device_id": { "name": "Computer", "description": "The computer(s) to query." },
        "sort": { "name": "Sort by", "description": "Sort order." },
        "limit": { "name": "Limit", "description": "Maximum number of processes per computer." }
      }
    }
  },
  "selector": {
    "action": {
      "options": {
        "shutdown": "Shut down",
